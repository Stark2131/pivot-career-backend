# ---- Copy to .env and adjust. Never commit real secrets. ----
ENVIRONMENT=development

# PostgreSQL (async driver)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/career_coach

# JWT - generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM provider: openai | gemini | none   (none = rule-based fallbacks only, no API calls)
LLM_PROVIDER=none
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Any OpenAI-compatible endpoint works (e.g. Azure/OpenRouter/local) by changing the base URL
OPENAI_BASE_URL=https://api.openai.com/v1
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=1

# Uploads & documents
MAX_RESUME_SIZE_MB=5
MAX_RESUME_PAGES=15
MAX_DOCUMENT_CHARS=30000

# Optional job-posting URL fetching (respects robots.txt, public hosts only)
URL_FETCH_ENABLED=true

# In-memory rate limiting (per client IP, per minute)
RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_PER_MINUTE=20
AI_RATE_LIMIT_PER_MINUTE=30

# JSON list
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173","http://127.0.0.1:5173"]
